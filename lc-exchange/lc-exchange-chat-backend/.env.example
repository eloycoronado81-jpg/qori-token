# Copiar como .env y completar antes de correr el servidor. Nunca commitear el .env real.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
PORT=3001
ALLOWED_ORIGIN=https://lc-exchange.com

# --- Depósitos USDT (verificación de pagos) ---
# ⚠️ Direcciones REALES de tu wallet en cada red. Si dejas una vacía, esa red
# queda deshabilitada en la calculadora (nunca se muestra una dirección
# inventada, para no arriesgar los fondos de un cliente).
DEPOSIT_ADDRESS_TRC20=
DEPOSIT_ADDRESS_ERC20=
DEPOSIT_ADDRESS_BEP20=

# Minutos que tiene el cliente para completar el depósito antes de que expire.
DEPOSIT_WINDOW_MINUTES=20

# API keys gratuitas de los exploradores, para verificar automáticamente si
# el depósito ya llegó. Sin la key correspondiente, esa red no se puede
# auto-verificar (queda en revisión manual).
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
TRONGRID_API_KEY=

# Umbral de confirmaciones antes de dar un depósito por válido (valores por
# defecto ya son razonables; solo cambiar si sabes lo que haces).
MIN_CONFIRMATIONS_ERC20=12
MIN_CONFIRMATIONS_BEP20=15
MIN_CONFIRMATIONS_TRC20=19
